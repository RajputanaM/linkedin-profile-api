# Copy this file to .env and fill in real values. Never commit .env.

# --- LinkedIn session cookies (obtained manually, see README "Setup") ---
# Value of the `li_at` cookie from a logged-in linkedin.com session.
LI_AT_COOKIE=

# Value of the `JSESSIONID` cookie from the same session (keep the
# surrounding double quotes exactly as LinkedIn sets them, e.g. "ajax:1234").
JSESSIONID=

# --- Our own API's access control ---
# Clients must send this value in the `x-api-key` header.
API_KEY=change-me-to-a-long-random-string

# --- Server ---
PORT=3000

# Max requests this service will forward to LinkedIn per minute, across all
# clients. Keep conservative to protect the LinkedIn account behind LI_AT_COOKIE.
LINKEDIN_RATE_LIMIT_PER_MINUTE=6
