{
  "name": "linkedin-profile-api",
  "version": "1.0.0",
  "description": "Hosted API that reverse-engineers LinkedIn's internal Voyager endpoints to return structured profile JSON",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "capture": "tsx scripts/capture-profile.ts"
  },
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "axios-cookiejar-support": "^5.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "tough-cookie": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
